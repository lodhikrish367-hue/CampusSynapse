# ===============================================================
# CampusSynapse Database & Server Configuration
# ===============================================================

# Flask server port
PORT=5000

# MySQL Configuration
# If MySQL is running locally, set your MySQL credentials below:
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=campus_teams_db

# Alternatively, set full DATABASE_URL:
# DATABASE_URL=mysql+pymysql://root:your_password_here@localhost:3306/campus_teams_db

# NOTE: If MySQL is not reachable, the backend automatically and seamlessly
# activates SQLite fallback (campus_teams.db) so you can test the system immediately!

